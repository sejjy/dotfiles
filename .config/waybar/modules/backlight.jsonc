{
	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": [
			"", "", "", "", "", "", "", "", ""
		],
		"min-length": 7,
		"max-length": 7,
		"on-scroll-up": "~/.local/bin/backlight up",
		"on-scroll-down": "~/.local/bin/backlight down",
		"tooltip-format": "Screen Brightness"
	}
}
