/* Emoji picker */

@theme "themes/catppuccin-mocha.rasi"

configuration {
	font:                   "CommitMono Nerd Font 12";
	display-emoji:          " ";
}

/* Window */

window {
	width:                  375px;
	border:                 4px;
	border-radius:          12px;
	border-color:           @br;
	background-color:       @bg-0;
	children:               [ mainbox ];
}

mainbox {
	margin:                 0 0 -1px;
	spacing:                0;
	background-color:       @br;
	text-color:             @fg;
	children:               [ textbox-custom, listview, inputbar ];
}

textbox-custom {
	font:                   "CommitMono Nerd Font Bold 12";
	horizontal-align:       0.5;
	padding:                2px 0;
	background-color:       @active-bg;
	text-color:             @active-fg;
	expand:                 false;
	content:                "󰱱 Emojis";
}

/* List */

listview {
	border:                 2px 0 0;
	border-radius:          10px;
	border-color:           @br;
	lines:                  5;
	columns:                5;
	fixed-columns:          true;
	dynamic:                false;
	cycle:                  true;
	margin:                 0 0 -24px;
	padding:                8px;
	background-color:       @bg-0;
}

element {
	padding:                8px;
	cursor:                 pointer;
	background-color:       inherit;
	text-color:             @fg;
}

element selected active,
element selected normal {
	border-radius:          8px;
	background-color:       @active-bg;
	text-color:             @active-fg;
}

element-text {
	font:                   "CommitMono Nerd Font 18";
	padding:                10px 0 10px 11px;
	cursor:                 inherit;
	background-color:       inherit;
	text-color:             inherit;
}

/* Input */

inputbar {
	margin:                 -40px 8px 8px;
	border-radius:          8px;
	spacing:                inherit;
	background-color:       @bg-1;
	text-color:             inherit;
	children:               [ prompt, entry ];
}

prompt {
	padding:                8px 6px 8px 12px;
	background-color:       inherit;
	text-color:             inherit;
}

entry {
	placeholder:            "Search";
	padding:                8px 12px 8px 0;
	cursor:                 text;
	background-color:       inherit;
	text-color:             inherit;
}
