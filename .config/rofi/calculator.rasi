/* Calculator */

@theme "themes/catppuccin-mocha.rasi"

configuration {
	font:                   "CommitMono Nerd Font 12";
	calc-display-format:    "{name}";
}

/* Window */

window {
	width:                  375px;
	height:                 116px;
	border:                 3px;
	border-color:           @br;
	background-color:       @bg-0;
	text-color:             @fg;
	children:               [ textbox-custom, message, inputbar ];
}

textbox-custom {
	content:                "CALCULATOR";
	font:                   "CommitMono Nerd Font Bold 12";
	expand:                 false;
	horizontal-align:       0.5;
	padding:                0 0 3px;
	background-color:       @active-bg;
	text-color:             @active-fg;
}

/* Output */

message {
	padding:                8px;
	background-color:       inherit;
	text-color:             inherit;
}

textbox {
	font:                   "CommitMono Nerd Font 18";
	horizontal-align:       1;
	background-color:       inherit;
	text-color:             inherit;
}

/* Input */

inputbar {
	margin:                 0 8px 0;
	background-color:       @bg-1;
	text-color:             inherit;
	children:               [ entry ];
}

entry {
	horizontal-align:       1;
	padding:                8px 12px;
	background-color:       inherit;
	text-color:             inherit;
	cursor:                 text;
}
