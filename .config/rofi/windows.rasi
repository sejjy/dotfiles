/* Window switcher */

@theme "themes/catppuccin-mocha.rasi"

configuration {
	font:                   "CommitMono Nerd Font 12";
	window-format:          "<span weight='bold'>{c:10}</span> <span alpha='80%' weight='light'><i>{t}</i></span>";
}

/* Window */

window {
	width:                  375px;
	height:                 262px;
	border:                 4px;
	border-radius:          12px;
	border-color:           @br;
	background-color:       @bg-0;
	children:               [ mainbox ];
}

mainbox {
	margin:                 0 0 -1px;
	spacing:                0;
	background-color:       @br;
	text-color:             @fg;
	children:               [ textbox-custom, listview ];
}

textbox-custom {
	font:                   "CommitMono Nerd Font Bold 12";
	horizontal-align:       0.5;
	padding:                2px 0;
	background-color:       @active-bg;
	text-color:             @active-fg;
	expand:                 false;
	content:                "󰖯 Windows";
}

/* List */

listview {
	border:                 2px 0 0;
	border-radius:          10px;
	border-color:           @br;
	lines:                  6;
	dynamic:                false;
	cycle:                  true;
	padding:                8px;
	background-color:       @bg-0;
}

element {
	padding:                8px;
	cursor:                 pointer;
	background-color:       inherit;
	text-color:             @fg;
}

element selected active,
element selected normal {
	border-radius:          8px;
	background-color:       @active-bg;
	text-color:             @active-fg;
}

element-text {
	padding:                0 8px;
	cursor:                 inherit;
	background-color:       inherit;
	text-color:             inherit;
}
