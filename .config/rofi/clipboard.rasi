/* Clipboard */

@theme "themes/catppuccin-mocha.rasi"

configuration {
	font:                   "CommitMono Nerd Font 12";
	drun-display-format:    "{name}";
}

/* Window */

window {
	width:                  375px;
	border:                 3px;
	border-color:           @br;
	background-color:       @bg-0;
	text-color:             @fg;
	children:               [ textbox-custom, listview, inputbar ];
}

textbox-custom {
	content:                "CLIPBOARD";
	font:                   "CommitMono Nerd Font Bold 12";
	expand:                 false;
	horizontal-align:       0.5;
	padding:                0 0 3px;
	background-color:       @active-bg;
	text-color:             @active-fg;
}

/* List */

listview {
	lines:                  9;
	fixed-height:           true;
	dynamic:                false;
	cycle:                  true;
	margin:                 0 0 -32px;
	padding:                8px 8px 0;
	background-color:       inherit;
	text-color:             inherit;
}

element-icon {
	size:                   22px;
	background-color:       transparent;
}

element {
	padding:                8px;
	background-color:       inherit;
	text-color:             inherit;
	cursor:                 pointer;
}

element selected active,
element selected normal {
	background-color:       @active-bg;
	text-color:             @active-fg;
}

element-text {
	padding:                0 8px;
	background-color:       inherit;
	text-color:             inherit;
	cursor:                 inherit;
}

/* Input */

inputbar {
	margin:                 0 8px 8px;
	background-color:       @bg-1;
	text-color:             inherit;
	children:               [ prompt, entry ];
}

prompt {
	padding:                8px 12px;
	background-color:       inherit;
	text-color:             inherit;
}

entry {
	padding:                8px 12px 8px 0;
	background-color:       inherit;
	text-color:             inherit;
	cursor:                 text;
}
