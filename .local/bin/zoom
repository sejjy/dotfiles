#!/usr/bin/env bash
#
# Glass magnifier zoom for Hyprland v0.55+
#
# Usage:
#     zoom [value]
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    October 24, 2026
# License: MIT

__SCRIPT__=${0##*/}

MIN=1.0

zoom() {
	local factor=$1

	hyprctl eval "hl.config({ cursor = { zoom_factor = $factor } })"
	printf "%s: cursor:zoom_factor set to %s\n" "$__SCRIPT__" "$factor"
}

main() {
	local value=$1
	# [+-]?         An optional sign
	# [0-9]+        One or more digits
	# (\.[0-9]+)?   An optional decimal point followed by one or more digits
	if ! [[ $value =~ ^[+-]?[0-9]+(\.[0-9]+)?$ ]]; then
		printf "%s: invalid value: '%s'\n" "$__SCRIPT__" "$value"
		printf "%s: resetting zoom...\n"   "$__SCRIPT__"
		zoom "$MIN"
		return 0
	fi

	local current factor
	current=$(hyprctl getoption cursor:zoom_factor | awk '/^float/ {print $2}')
	factor=$(awk -v   v="$value"   \
	             -v   c="$current" \
	             -v min="$MIN"     \
	             'BEGIN {
	             	f = c + v
	             	if (f < min) f = min
	             	print f
	             }')

	zoom "$factor"
}

main "$@"
