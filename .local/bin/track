#!/usr/bin/env bash
#
# Print the current track
#
# Dependencies:
#   - playerctl
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    July 31, 2025
# License: MIT

MAX=40

print_help() {
	local script=${0##*/}

	cat <<-EOF
		$script: $script <option>
		    Print the current track

		    Options:
		      trunc     Truncate output to [max] characters (default: $MAX)
	EOF
}

get() {
	playerctl metadata --format "{{ markup_escape($1) }}"
}

main() {
	local status
	status=$(get "status")

	case $status in
		Playing) icon="󰐊" ;;
		Paused)  icon="󰏤" ;;
		*)       return 1 ;;
	esac

	local title artist
	title=$(get "title")
	artist=$(get "artist")

	local track="$title — $artist"

	local option=$1
	if [[ $option == trunc ]] && ((${#track} > MAX)); then
		track=${track:0:MAX}
		track+="…"
	else
		print_help >&2
		return 1
	fi

	printf "%s %s\n" "$icon" "$track"
}

main "$@"
