#!/usr/bin/env bash
#
# Take a screenshot of the target passed
#
# Dependencies:
#   - grimblast
#   - libnotify (notify-send)
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    January 2, 2025
# License: MIT

usage() {
	local script=${0##*/}

	cat <<-EOF
		$script: $script <target>
		    Take a screenshot of the target passed

		    Targets:
		      active       Currently active window
		      area         Manually select a rectangular region or window
		      output       Currently active output
		      screen       Entire screen including all visible outputs
	EOF
}

main() {
	local dir="$HOME/Pictures/screenshots"
	if [[ ! -d $dir ]]; then
		mkdir -p "$dir"
	fi

	local name file
	name="$(date +%Y-%m-%d_%H-%M-%S-%2N).png"
	file="$dir/$name"

	local option=$1
	case $option in
		area)
			grimblast --freeze copysave "$1" "$file"
			;;
		active | output | screen)
			grimblast copysave "$1" "$file"
			;;
		*)
			usage >&2
			return 1
			;;
	esac

	if [[ ! -s $file ]]; then
		rm -f "$file"
		return 1
	fi

	notify-send "$name saved in $dir" --icon "$file"
}

main "$@"
