#!/usr/bin/env bash
#
# Notify when the battery state changes
#
# Dependencies:
#   - upower
#   - libnotify (notify-send)
#
# Reference:
# https://github.com/ericmurphyxyz/dotfiles/blob/master/.local/bin/battery-charging
#
# Add the following rules to /etc/udev/rules.d/60-power.rules
# (replace USER with your username):
#
# ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="/usr/bin/su USER -c '~/.local/bin/battery charging'"
# ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="/usr/bin/su USER -c '~/.local/bin/battery discharging'"
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 15, 2025
# License: MIT

export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
export DISPLAY=:0

print_help() {
	local script=${0##*/}

	cat <<-EOF
		$script: $script {charging | discharging}
		    Notify when the battery state changes

		    See ${0/$HOME/'~'} for more information
	EOF
}

main() {
	local state=$1

	if [[ ! $state =~ ^(dis)?charging$ ]]; then
		print_help >&2
		return 1
	fi

	local path
	path=$(upower -e | grep -m 1 "BAT")

	local level
	level=$(upower -i "$path" | awk '/percentage:/ {print $2}')
	level=${level%\%}

	local floor=$((level / 10 * 10))

	local icon
	printf -v icon "battery-%03d" $floor
	if [[ $state == charging ]]; then
		icon+="-charging"
	fi

	notify-send "Battery ${state^} (${level}%)" --icon "$icon" \
		--hint string:x-canonical-private-synchronous:battery
}

main "$@"
