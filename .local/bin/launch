#!/usr/bin/env bash
#
# Rofi launcher
#
# Requires cliphist, rofi, rofi-calc, rofi-emoji, and wl-clipboard (wl-copy)
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    January 3, 2025
# License: MIT

DIR="$HOME/.config/rofi"

usage() {
	cat <<- EOF
		USAGE: ${0##*/} {app|calc|clip|emoji|win}

		Rofi launcher

		OPTIONS:
		  app      App launcher
		  calc     Calculator
		  clip     Clipboard
		  emoji    Emoji picker
		  win      Window switcher
	EOF
}

main() {
	case $1 in
		app)
			pkill rofi ||
			      rofi -show drun       \
			           -disable-history \
			           -config "$DIR/apps.rasi"
			;;
		calc)
			pkill rofi ||
			      rofi -show calc                                  \
			           -modi calc                                  \
			           -hint-welcome ""                            \
			           -hint-result ""                             \
			           -kb-accept-entry ""                         \
			           -kb-accept-custom "Return"                  \
			           -terse                                      \
					   -calc-command "printf '{result}' | wl-copy" \
			           -config "$DIR/calculator.rasi"
			;;
		clip)
			pkill rofi ||
				cliphist list |
			      rofi -dmenu             \
			           -display-columns 2 \
			           -p ""             \
			           -config "$DIR/clipboard.rasi" |
				cliphist decode |
				wl-copy
			;;
		emoji)
			pkill rofi ||
			      rofi -modi emoji             \
			           -show emoji             \
			           -emoji-format "{emoji} <span weight='500'>{name}</span>[<span alpha='60%'><i> ({keywords})</i></span>]" \
			           -kb-accept-alt ""       \
			           -kb-custom-1 Ctrl+c     \
			           -kb-secondary-copy ""   \
			           -config "$DIR/emojis.rasi"
			;;
		win)
			pkill rofi ||
			      rofi -show window \
			           -config "$DIR/windows.rasi"
			;;
		*)
			usage >&2
			return 1
			;;
	esac
}

main "$@"
